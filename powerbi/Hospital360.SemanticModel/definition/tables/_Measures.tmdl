	measure 'SLA Compliance %' = DIVIDE(CALCULATE([Incident Count],'analytics fact_it_incident'[sla_met_flag]=TRUE()),CALCULATE([Incident Count],NOT ISBLANK('analytics fact_it_incident'[resolved_at])))
		formatString: 0.00%
		displayFolder: Enterprise IT
		lineageTag: 5630c46e-fb5b-5d4b-af32-6c4d1e70638b

	measure 'Mean Resolution Time' = AVERAGE('analytics fact_it_incident'[resolution_minutes])
		formatString: #,0.00
		displayFolder: Enterprise IT
		lineageTag: 18786b15-5bf2-5cb4-95e0-ced1e20c0a16

	measure 'IT Error Rate' = DIVIDE(SUM('analytics fact_it_system_daily'[error_count]),SUM('analytics fact_it_system_daily'[transaction_count]))
		formatString: 0.00%
		displayFolder: Enterprise IT
		lineageTag: 2fed78fa-06e2-513e-8860-d1c377d5560c

	measure 'System Transaction Volume' = SUM('analytics fact_it_system_daily'[transaction_count])
		formatString: #,0
		displayFolder: Enterprise IT
		lineageTag: efb6f0e8-3821-58bc-ad1b-2b12e5eb2ee3

	measure 'Incidents per 10K Transactions' = DIVIDE([Incident Count]*10000,[System Transaction Volume])
		formatString: #,0.00
		displayFolder: Enterprise IT
		lineageTag: 29d8e6d0-826b-5c35-8953-a222505e7363

