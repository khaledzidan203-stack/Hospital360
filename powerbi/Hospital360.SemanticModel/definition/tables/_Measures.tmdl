	measure 'Top Payer Share' =
			VAR IdentifiedPayers =
			    FILTER (
			        ALLSELECTED ( 'analytics dim_payer'[payer_key] ),
			        'analytics dim_payer'[payer_key] <> 0
			    )
			VAR TopPayerAmount =
			    MAXX (
			        IdentifiedPayers,
			        CALCULATE ( [Transaction Amount] )
			    )
			VAR SelectedTotal =
			    CALCULATE (
			        [Transaction Amount],
			        ALLSELECTED ( 'analytics dim_payer'[payer_key] )
			    )
			RETURN
			    DIVIDE ( TopPayerAmount, SelectedTotal )
		lineageTag: 76f9f95f-766f-41a5-849c-9e1d96e18a10

	measure 'Unknown Payer %' =
			DIVIDE (
			    CALCULATE (
			        [Total Claims],
			        'analytics dim_payer'[payer_key] = 0
			    ),
			    CALCULATE (
			        [Total Claims],
			        REMOVEFILTERS ( 'analytics dim_payer' )
			    )
			)
		lineageTag: cdc0f302-6b90-4b1f-b975-b429f599eccd

	measure 'Top Provider Share' =
			VAR IdentifiedProviders =
			    FILTER (
			        ALLSELECTED ( 'analytics dim_provider'[provider_key] ),
			        'analytics dim_provider'[provider_key] <> 0
			    )
			VAR TopProviderEncounters =
			    MAXX (
			        IdentifiedProviders,
			        CALCULATE ( [Total Encounters] )
			    )
			VAR SelectedTotal =
			    CALCULATE (
			        [Total Encounters],
			        ALLSELECTED ( 'analytics dim_provider'[provider_key] )
			    )
			RETURN
			    DIVIDE ( TopProviderEncounters, SelectedTotal )
		lineageTag: 07e0a85a-1b60-44bd-bb3a-52b00e7a488d

	measure 'Top Organization Share' =
			VAR IdentifiedOrganizations =
			    FILTER (
			        ALLSELECTED ( 'analytics dim_organization'[organization_key] ),
			        'analytics dim_organization'[organization_key] <> 0
			    )
			VAR TopOrganizationEncounters =
			    MAXX (
			        IdentifiedOrganizations,
			        CALCULATE ( [Total Encounters] )
			    )
			VAR SelectedTotal =
			    CALCULATE (
			        [Total Encounters],
			        ALLSELECTED ( 'analytics dim_organization'[organization_key] )
			    )
			RETURN
			    DIVIDE ( TopOrganizationEncounters, SelectedTotal )
		lineageTag: 45c166d8-b328-4ab3-8ae2-10bc6c9f2f44

	measure 'Unknown Transaction Payer %' =
			DIVIDE (
			    CALCULATE (
			        [Total Claim Transactions],
			        'analytics dim_payer'[payer_key] = 0
			    ),
			    CALCULATE (
			        [Total Claim Transactions],
			        REMOVEFILTERS ( 'analytics dim_payer' )
			    )
			)
		lineageTag: bca6d5e0-9bb5-4d62-9743-c7667c9f34ce

	measure 'Sentinel To-Date %' =
			
			DIVIDE (
			    [Sentinel To-Date Transactions],
			    [Total Claim Transactions]
			)
		lineageTag: 47544faa-a91d-459b-adc7-2cbd8970f7e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Encounters by Stop Date' =
			CALCULATE (
			    [Total Encounters],
			    USERELATIONSHIP (
			        'analytics dim_date'[date_key],
			        'analytics fact_encounter'[stop_date_key]
			    )
			)
		lineageTag: 4138b283-c94f-4dcd-b3b8-dd080dea2fd1

	measure 'Procedures by Stop Date' =
			CALCULATE (
			    [Total Procedures],
			    USERELATIONSHIP (
			        'analytics dim_date'[date_key],
			        'analytics fact_procedure'[stop_date_key]
			    )
			)
		lineageTag: d11041df-94da-4126-a53c-97a21aeb79a3

	measure 'Enterprise Revenue' = SUM('analytics fact_finance_monthly'[operating_revenue])
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 6311e97c-0220-5018-983f-f8f2f7499377

	measure 'Enterprise Operating Cost' = SUM('analytics fact_finance_monthly'[operating_cost])
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 19072287-a2a3-5299-bd74-d981210baf55

	measure 'Enterprise Operating Margin' = [Enterprise Revenue] - [Enterprise Operating Cost]
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 3287ec7d-26bd-5fd1-b2c2-a0f161f8fe69

	measure 'Enterprise Operating Margin %' = DIVIDE([Enterprise Operating Margin],[Enterprise Revenue])
		formatString: 0.00%
		displayFolder: Enterprise Finance
		lineageTag: 3843033a-7633-54c2-b39b-107dda095bdc

	measure 'Budget Revenue' = CALCULATE(SUM('analytics fact_budget_monthly'[budget_revenue]),'analytics dim_budget_scenario'[budget_scenario_code]="ORIGINAL")
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: ae3fe06b-f67c-5980-9775-ed00863df8b2

	measure 'Budget Cost' = CALCULATE(SUM('analytics fact_budget_monthly'[budget_operating_cost]),'analytics dim_budget_scenario'[budget_scenario_code]="ORIGINAL")
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: c9ea3f95-4627-52ed-8e8b-66666edc707a

	measure 'Revenue Variance' = [Enterprise Revenue]-[Budget Revenue]
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 7b66456b-c1fc-5d99-84c4-7dfb926d5009

	measure 'Cost Variance' = [Enterprise Operating Cost]-[Budget Cost]
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 23f0a636-0fef-5a6a-bd12-60fb659fdb79

	measure 'Budget Variance' = [Enterprise Operating Margin]-([Budget Revenue]-[Budget Cost])
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: df9446de-ff26-540d-9a1a-bdc25855e2c4

	measure 'Budget Variance %' = DIVIDE([Budget Variance],ABS([Budget Revenue]-[Budget Cost]))
		formatString: 0.00%
		displayFolder: Enterprise Finance
		lineageTag: bc6f480f-93ca-555d-bcd8-a28713f912e7

	measure 'Enterprise Cost per Encounter' = DIVIDE([Enterprise Operating Cost],[Enterprise Encounter Volume])
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: 61e74e01-3ef7-568f-a97e-30e1a40b059c

	measure 'Enterprise Revenue per Encounter' = DIVIDE([Enterprise Revenue],[Enterprise Encounter Volume])
		formatString: $#,0.00
		displayFolder: Enterprise Finance
		lineageTag: f0a16872-568b-5208-8297-ad67f836be29

	measure 'Enterprise Payroll Cost' = SUM('analytics fact_finance_monthly'[payroll_cost])
