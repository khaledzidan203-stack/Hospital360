table _Measures
	lineageTag: bb0c2478-e50f-4e50-a6e7-7dbcda7cebe3

	measure 'Total Patients' =
			
			CALCULATE(
			    COUNTROWS('analytics dim_patient'),
			    'analytics dim_patient'[patient_key] <> 0
			)
		formatString: 0
		lineageTag: e6dc977b-538d-4edb-abe8-1fffa8c1230f

	measure 'Total Claims' =
			
