    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Analytical Limitations",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "20px",
                      "color": "#0f4c45"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": "• Dataset is synthetic.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Results demonstrate analytics, not real hospital performance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Claim and transaction amounts are not hospital profitability.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Synthetic clinical patterns are not clinical evidence.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Unknown members are retained for analytical integrity.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The Synthea unset TO_DATE sentinel uses the source epoch timestamp.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Sentinel and chronology warnings are distinct concepts.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Some non-sentinel TO_DATE values precede FROM_DATE and remain warnings.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• No causality should be inferred from associations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#1f2933"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
